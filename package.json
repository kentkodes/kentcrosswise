{
  "name": "kentcrosswise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "pnpm --filter @kcw/scripts migrate",
    "seed": "pnpm --filter @kcw/scripts seed",
    "check-prod-bundle": "pnpm --filter @kcw/scripts check-prod-bundle",
    "build-web": "pnpm --filter @kcw/scripts build-web",
    "build-lambdas": "pnpm --filter @kcw/scripts build-lambdas",
    "check-preview-clean": "pnpm --filter @kcw/scripts check-preview-clean",
    "plan-summary": "pnpm --filter @kcw/scripts plan-summary",
    "merge-input": "pnpm --filter @kcw/scripts merge-input",
    "smoke-check": "pnpm --filter @kcw/scripts smoke-check",
    "preview-gc": "pnpm --filter @kcw/scripts preview-gc",
    "check-repo-settings": "pnpm --filter @kcw/scripts check-repo-settings",
    "apply-repo-settings": "pnpm --filter @kcw/scripts apply-repo-settings",
    "agent-context": "pnpm --filter @kcw/scripts agent-context",
    "agent-publish": "pnpm --filter @kcw/scripts agent-publish",
    "kcw-report": "pnpm --filter @kcw/report kcw-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
