{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", "test", "e2e", "next.config.ts", "open-next.config.ts", "playwright.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "test/fixtures"]
}
