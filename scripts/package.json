{
  "name": "@kcw/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Repo scripts (Node/TS via tsx; never bash or PowerShell)",
  "type": "module",
  "scripts": {
    "migrate": "tsx migrate.ts",
    "seed": "tsx seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-prod-bundle": "tsx check-prod-bundle.ts",
    "build-web": "tsx build-web.ts",
    "build-lambdas": "tsx build-lambdas.ts",
    "check-preview-clean": "tsx check-preview-clean.ts",
    "plan-summary": "tsx plan-summary.ts",
    "merge-input": "tsx merge-input.ts",
    "smoke-check": "tsx smoke-check.ts",
    "preview-gc": "tsx preview-gc.ts",
    "check-repo-settings": "tsx check-repo-settings.ts",
    "apply-repo-settings": "tsx apply-repo-settings.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1154.0",
    "@aws-sdk/client-iam": "^3.1154.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1154.0",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/client-ssm": "^3.1154.0",
    "@electric-sql/pglite": "^0.5.11",
    "@kcw/core": "workspace:*",
    "@kcw/db": "workspace:*",
    "@kcw/secrets": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@kcw/merge-rules": "workspace:*",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2"
  }
}
